{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "jetbrains": {
        "type": "remote",
        "url": "http://127.0.0.1:64421/stream"
      },
      "intellij-index": {
        "type": "remote",
        "url": "http://127.0.0.1:29170/index-mcp/streamable-http"
      }
    }
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      ".git/**",
      "**/*.min.js",
      "**/*.map",
      "**/*.lock"
    ]
  },
  "compaction": {
    "auto": true
  },
  "plugins": [
    "./plugins/v2/init.ts",
    "./plugins/v2/MemPalaceAutosaveHook.ts"
  ]
}